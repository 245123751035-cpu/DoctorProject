# Database connection (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://doctor:doctorpass@localhost:5433/doctor?schema=public"

# Secret used to sign session cookies (generate a strong random string)
AUTH_SECRET="change-me-to-a-long-random-string"

# AI provider configuration
# Valid providers: "mock" | "openai" | "anthropic" | "gemini"
AI_PROVIDER="mock"

# Optional API keys for the real AI provider (only needed if AI_PROVIDER != mock)
AI_API_KEY=""
AI_MODEL=""

# Optional: use a provider to translate/summarize in the selected UI language
AI_TRANSLATE_ENABLED="false"
